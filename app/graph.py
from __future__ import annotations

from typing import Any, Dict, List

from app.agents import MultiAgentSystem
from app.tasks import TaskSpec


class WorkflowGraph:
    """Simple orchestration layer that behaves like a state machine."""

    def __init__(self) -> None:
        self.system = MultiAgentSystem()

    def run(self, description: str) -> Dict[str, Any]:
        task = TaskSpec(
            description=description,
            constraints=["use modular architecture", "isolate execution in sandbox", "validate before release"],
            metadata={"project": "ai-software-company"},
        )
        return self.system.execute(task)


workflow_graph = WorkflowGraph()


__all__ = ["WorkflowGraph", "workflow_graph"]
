class MultiAgentSystem:
    def __init__(self) -> None:
        self.agents = {
            "ceo": CEOAgent(),
            "researcher": ResearcherAgent(),
            "architect": ArchitectAgent(),
            "developer": DeveloperAgent(),
            "qa": QAAgent(),
            "postmortem": PostMortemAgent(),
            "self_updater": SelfUpdaterAgent(),
        }

    def execute(self, task: TaskSpec) -> Dict[str, Any]:
        result = []
        for agent_name in ["ceo", "researcher", "architect", "developer", "qa", "postmortem", "self_updater"]:
            result.append(self.agents[agent_name].run(task))
        return {"task": task.description, "state": "released", "agents": result}


