from __future__ import annotations

import json
from typing import Any, Dict, List

from app.config import settings
from app.memory import memory
from app.tasks import TaskSpec
from app.tools import run_python_in_sandbox, search_web, write_text


class BaseAgent:
    def __init__(self, name: str, role: str, system_prompt: str) -> None:
        self.name = name
        self.role = role
        self.system_prompt = system_prompt

    def run(self, task: TaskSpec) -> Dict[str, Any]:
        raise NotImplementedError


class CEOAgent(BaseAgent):
    def __init__(self) -> None:
        super().__init__(
            "CEO",
            "Orchestrator",
            "Define the objective, assign work, and ensure final output matches the company vision.",
        )

    def run(self, task: TaskSpec) -> Dict[str, Any]:
        return {
            "agent": self.name,
            "role": self.role,
            "state": "task_received",
            "summary": f"Görev kabul edildi: {task.description}",
        }


class ResearcherAgent(BaseAgent):
    def __init__(self) -> None:
        super().__init__(
            "Researcher",
            "Research",
            "Search for the latest docs, versions, and patterns relevant to the task.",
        )

    def run(self, task: TaskSpec) -> Dict[str, Any]:
        search_results = search_web(task.description)
        summary = {
            "task": task.description,
            "findings": [
                "Yeni kütüphaneler ve araçlar için güncel arama sonuçları toparlandı.",
                "Mimari tasarım için modüler yapı ve doğrulama katmanı şarttır.",
                "Güvenli çalışma ortamı (sandbox) ve test döngüsü olmazsa üretime geçmek risklidir.",
            ],
            "results": search_results[:3],
        }
        memory.store("research_summary", summary, tags=["research", task.description])
        return {
            "agent": self.name,
            "role": self.role,
            "state": "research_done",
            "data": summary,
        }


