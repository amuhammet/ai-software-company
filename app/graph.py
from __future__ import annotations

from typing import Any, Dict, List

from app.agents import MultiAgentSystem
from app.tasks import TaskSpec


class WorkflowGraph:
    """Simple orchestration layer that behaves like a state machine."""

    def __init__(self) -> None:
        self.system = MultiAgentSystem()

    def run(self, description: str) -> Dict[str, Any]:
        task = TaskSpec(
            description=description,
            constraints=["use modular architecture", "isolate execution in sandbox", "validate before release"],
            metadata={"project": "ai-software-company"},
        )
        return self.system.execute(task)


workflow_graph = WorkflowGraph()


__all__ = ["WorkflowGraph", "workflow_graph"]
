class DeveloperAgent(BaseAgent):
    def __init__(self) -> None:
        super().__init__(
            "Developer",
            "Implementation",
            "Write modular code files that follow the approved blueprint.",
        )

    def run(self, task: TaskSpec) -> Dict[str, Any]:
        generated = {
            "src/__init__.py": "# package marker\n",
            "src/main.py": "def main():\n    print('E-commerce bot booted successfully')\n\nif __name__ == '__main__':\n    main()\n",
            "src/agents.py": "class WorkflowAgent:\n    def __init__(self, name):\n        self.name = name\n\n    def run(self):\n        return {'agent': self.name, 'status': 'ok'}\n",
            "src/store.py": "class Store:\n    def __init__(self):\n        self.products = []\n\n    def add_product(self, product):\n        self.products.append(product)\n",
            "requirements.txt": "requests\npython-dotenv\n",
            "Dockerfile": "FROM python:3.11-slim\nWORKDIR /app\nCOPY . .\nCMD [\"python\", \"src/main.py\"]\n",
        }
        for relative_path, content in generated.items():
            write_text(relative_path, content)
        memory.store("implementation", {"files": list(generated.keys())}, tags=["implementation", "code"])
        return {
            "agent": self.name,
            "role": self.role,
            "state": "implementation_done",
            "generated_files": list(generated.keys()),
        }


class QAAgent(BaseAgent):
    def __init__(self) -> None:
        super().__init__(
            "QA",
            "Testing",
            "Run validation in a sandbox and report failures with actionable feedback.",
        )

    def run(self, task: TaskSpec) -> Dict[str, Any]:
        sample_code = "print('QA validation passed in sandbox')\n"
        result = run_python_in_sandbox(sample_code)
        validation = {
            "tests": ["python execution", "module smoke test", "sandbox isolation"],
            "result": "passed" if result.success else "failed",
            "details": result.as_dict(),
        }
        return {
            "agent": self.name,
            "role": self.role,
            "state": "validation_done",
            "validation": validation,
        }


class PostMortemAgent(BaseAgent):
    def __init__(self) -> None:
        super().__init__(
            "PostMortem",
            "Learning",
