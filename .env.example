# Copy this to .env and adjust values as needed.
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=platform_secret
POSTGRES_DB=ai_platform_db
DATABASE_URL=postgresql+psycopg2://platform_user:platform_secret@localhost:5432/ai_platform_db
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
JWT_SECRET=super-secret-key-change-me
APP_SECRET_KEY=super-secret-key-change-me
DEFAULT_MODEL=ollama/llama3
DEFAULT_ORG_BUDGET_USD=500.0
ALLOWED_PROVIDERS=ollama,openai,anthropic,gemini,azure
DEBUG=false
APP_ENV=development
